  "cases": [
    {
      "id": "obs-01-comment-qtext",
      "uid": 1200,
      "family": "OBS-01",
      "section": "4.1",
      "test": "obsolete_receive_obs_01_comment_qtext",
      "expected": {
        "subject": "Fictional obsolete syntax",
        "fromAddress": "sender@example.test",
        "toAddresses": "Reader <reader@example.test>",
        "ccAddresses": "",
        "bccAddresses": "",
        "replyToAddresses": "",
        "receivedAt": "2026-07-28T12:01:00+00:00",
        "bodyText": "Fictional body obs-01-comment-qtext.\r\n",
        "fromName": "A\u0001B (note\u0002)"
      },
      "proposedSemantics": "Preserve the exact declared source-text projection and separate actionable mailbox identity. Retain original raw octets; do not claim preferred modern rendering or a universal obsolete-grammar certificate.",
      "rawExportRequired": true,
      "coreProjectionPolicy": "Intentional core/source-text preservation tolerance. Exact control-bearing text survives parsing and Store/cache reopen; this does not prescribe visible control glyphs or prove frontend/Tauri/WebKit/clipboard/search rendering. Actionable CTL-bearing addresses must be rejected before SMTP rather than cleaned into another identity."
    },
