{
  "name": "dakia",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "dev:desktop-web": "npm run bundle:cli:dev && npm run dev:web",
    "tauri": "tauri",
    "build": "npm run prepare:desktop-assets && tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "build:web": "vite build --config apps/desktop/vite.config.ts",
    "build:desktop-web": "npm run bundle:cli && npm run build:web",
    "bundle:cli": "./scripts/bundle-cli.sh release",
    "bundle:cli:dev": "./scripts/bundle-cli.sh debug",
    "setup:worktree": "./scripts/setup-worktree.sh",
    "prepare:desktop-assets": "./scripts/prepare-desktop-assets.sh",
    "verify:classifier-assets": "node scripts/verify-classifier-assets.mjs",
    "prepare:onnx-runtime": "./scripts/prepare-onnx-runtime.sh",
    "build:install:bundle": "npm run prepare:desktop-assets && tauri build --bundles app --config apps/desktop/src-tauri/tauri.install.conf.json",
    "build:install": "./scripts/install-built-app.sh",
    "verify:local": "./scripts/verify-local-release.sh",
    "release:build": "./scripts/build-local-macos-release.sh",
    "release:publish": "./scripts/publish-local-production-release.sh",
    "test:updater-manifest": "node --test scripts/updater-manifest.node-test.mjs",
    "test:change-classifier": "node --test scripts/change-classifier.node-test.mjs",
    "test:release-scripts": "node --test scripts/*.node-test.mjs",
    "audit:dependencies": "./scripts/audit-dependencies.sh",
    "audit:dependencies:npm": "./scripts/audit-dependencies.sh --npm",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:translation-worker": "node scripts/test-offline-translation-worker.mjs",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@mantine/core": "^8.2.1",
    "@mantine/hooks": "^8.2.1",
    "@mantine/notifications": "^8.2.1",
    "@tabler/icons-react": "^3.34.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
