{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dakia",
  "version": "0.4.2",
  "identifier": "dev.dakia.mail",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:desktop-web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dakia",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost https://analytics.dakiamail.com; img-src 'self' asset: http://asset.localhost data: http: https:; style-src 'self' 'unsafe-inline' http: https:; font-src 'self' data: http: https:; frame-src 'self'; worker-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/translation-models/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/dakia"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/email-classifier-v2/*": "resources/email-classifier-v2/",
      "resources/licenses/*": "licenses/",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Productivity",
    "shortDescription": "A private, multi-account desktop mail client",
    "longDescription": "Dakia brings multiple IMAP accounts, fast local search, offline email translation, and a CLI into one private mail application.",
    "copyright": "Copyright 2026 Dakia contributors",
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Developer ID Application: Mashal Tech OU (34T9L3FGZC)",
      "frameworks": ["./frameworks/libonnxruntime.1.23.2.dylib"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQUIwN0QyNzVCMzdENjAKUldSZ2ZiTjEwZ2VyTXVLMXVPQVFrdEtLMHVvY3MwczNWMzRHOXhWTGlwY0MxNkM2SUlteHFCcXYK",
      "endpoints": ["https://downloads.dakiamail.com/macos/latest/latest.json"]
    }
  }
}
