{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-mail",
  "description": "Main mail window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-get-all-windows",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:default",
    "autostart:default",
    "os:allow-arch",
    "os:allow-os-type",
    "os:allow-version",
    "process:allow-restart",
    "updater:default",
    "allow-main-mail"
  ]
}
